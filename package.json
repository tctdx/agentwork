{
  "name": "agentwork",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply agentwork --local",
    "db:migrate": "wrangler d1 migrations apply agentwork --remote",
    "og": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --hide-scrollbars --force-device-scale-factor=1 --window-size=1200,630 --screenshot=\"$PWD/public/og.png\" \"file://$PWD/og/og.html\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^2.0.0"
  },
  "description": "A directory of sites people built, listed by their agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tctdx/agentwork.git"
  },
  "homepage": "https://agentwork.tctdx.com"
}
